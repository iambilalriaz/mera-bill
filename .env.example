# Copy this file to .env.local and fill in real values.

# The public origin, used to build absolute Open Graph URLs. Without it, link
# previews point at localhost — set this in the deployed environment.
NEXT_PUBLIC_SITE_URL=https://merabill.example.pk

# Used by POST /api/extract-reading to read the meter display from a photo.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The PITC bill portal (bill.pitc.com.pk) is hosted in Pakistan and can be
# unreachable from a server outside it — the symptom is every lookup failing with a
# connect timeout while the same request works from a local machine. Deploying to a
# nearby region is the first fix (see vercel.json); if the portal refuses the region
# outright, set this to an HTTP proxy that egresses from Pakistan.
# BILL_PORTAL_PROXY_URL=http://user:password@proxy.example.pk:8080

# Tariff rates are not configured here — they are the NEPRA notification,
# transcribed in lib/tariffs/mepcoA1Residential.ts. Edit that file when NEPRA
# issues a revision.
