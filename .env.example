# Copy this file to .env.local and fill in real values.

# The public origin, used to build absolute Open Graph URLs. Without it, link
# previews point at localhost — set this in the deployed environment.
NEXT_PUBLIC_SITE_URL=https://merabill.example.pk

# Used by POST /api/extract-reading to read the meter display from a photo.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required to look up bills from a host outside Pakistan. The PITC bill portal
# (bill.pitc.com.pk) accepts connections only from Pakistani IP space — verified
# unreachable from 25 nodes worldwide — so a deployment needs an HTTP proxy that
# egresses from Pakistan. Unset is correct for local development inside the country.
# No Vercel region is a substitute; see the deploying section of the README.
# BILL_PORTAL_PROXY_URL=http://user:password@proxy.example.pk:8080

# Tariff rates are not configured here — they are the NEPRA notification,
# transcribed in lib/tariffs/mepcoA1Residential.ts. Edit that file when NEPRA
# issues a revision.
